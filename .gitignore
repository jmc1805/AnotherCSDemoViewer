tools/node_modules/
tools/work/
tools/package-lock.json

# ── Desktop build output (tools/build_desktop.py) ─────────────────────────────
/build/
/dist/

# ── Parser test artifacts ─────────────────────────────────────────────────────
test_out.json
test_chunks/

# ── HLTV rating notebook (notebooks/) ──────────────────────────────────────────
