# ── All generated/runtime data lives under data/ (docs/data_layout.md) ────────
# = the default CS2VIEWER_DATA_DIR: demos, processed_matches, chunks,
# overwatch_raw, analysis_data, demo_map.json. One line covers all of it.
/data/
*.dem

# ── Valve-derived assets - source locally yourself, never commit/redistribute ─
# 2D radar overview images, one per map (manually sourced - see README
# "Supported Maps"); deliberately not shipped in the repo for copyright reasons.
static/map/
# CS2 UI image assets (skill-group / map / overhead / equipment icons) extracted
# from csgo/pak_01_dir.vpk by tools/extract_ui_assets.* - Valve content, sourced
# locally; presence gates the icon features (docs/ui_feature_expansion_plan.md §1).
static/assets/

